{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://suc-os.dev/schemas/event.schema.json",
  "title": "SUC Event",
  "description": "Canonical event object stored at events/{eventId}.json.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "lifecycle",
    "event_id",
    "name",
    "event_type",
    "route_group_ids"
  ],
  "properties": {
    "schema_version": {
      "type": "string",
      "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"
    },
    "lifecycle": {
      "type": "object",
      "additionalProperties": false,
      "required": ["state", "appended_at", "source"],
      "properties": {
        "state": {
          "type": "string",
          "enum": ["draft", "published", "deprecated", "archived"]
        },
        "appended_at": {
          "type": "string",
          "format": "date-time"
        },
        "source": {
          "type": "string",
          "minLength": 1
        },
        "supersedes_event_id": {
          "type": "string",
          "minLength": 1
        },
        "deprecated_by_event_id": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "event_id": {
      "type": "string",
      "minLength": 1
    },
    "name": {
      "type": "string",
      "minLength": 1
    },
    "description": {
      "type": "string"
    },
    "event_type": {
      "type": "string",
      "enum": ["crew-run", "training-run", "race", "camp", "social"]
    },
    "starts_at": {
      "type": ["string", "null"]
    },
    "start_location": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "url", "lat", "lng"],
      "properties": {
        "name": {
          "type": "string"
        },
        "url": {
          "type": "string"
        },
        "lat": {
          "type": ["number", "null"]
        },
        "lng": {
          "type": ["number", "null"]
        }
      }
    },
    "route_group_ids": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      },
      "uniqueItems": true
    },
    "segment_ids": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      },
      "uniqueItems": true
    },
    "source_legacy": {
      "type": "object",
      "description": "Legacy source snapshot for auditability. Allowed during migration only."
    }
  }
}
