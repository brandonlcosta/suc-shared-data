{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://suc-os.dev/schemas/challenge.schema.json",
  "title": "SUC Canonical Challenge",
  "description": "Canonical challenge object (optional during migration).",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "lifecycle",
    "challenge_id",
    "name",
    "status"
  ],
  "properties": {
    "schema_version": {
      "type": "string",
      "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"
    },
    "lifecycle": {
      "type": "object",
      "additionalProperties": false,
      "required": ["state", "appended_at", "source"],
      "properties": {
        "state": {
          "type": "string",
          "enum": ["draft", "published", "deprecated", "archived"]
        },
        "appended_at": {
          "type": "string",
          "format": "date-time"
        },
        "source": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "challenge_id": {
      "type": "string",
      "minLength": 1
    },
    "name": {
      "type": "string",
      "minLength": 1
    },
    "description": {
      "type": "string"
    },
    "status": {
      "type": "string",
      "enum": ["planned", "active", "completed", "archived"]
    },
    "route_group_ids": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      },
      "uniqueItems": true
    }
  }
}

